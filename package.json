{
  "name": "eventually",
  "version": "1.0.0",
  "description": "Background job processing API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "start:dev": "ts-node src/main.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --config ./test/jest-all.json --coverage --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "seed": "ts-node -r dotenv/config src/scripts/seed.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.18.0",
    "bullmq": "^5.0.0",
    "mongoose": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "axios": "^1.6.0",
    "sharp": "^0.33.0",
    "fast-csv": "^5.0.0",
    "zod": "^3.22.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testMatch": ["<rootDir>/test/unit/**/*.spec.ts"],
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "test/tsconfig.json" }]
    },
    "collectCoverageFrom": ["src/**/*.(t|j)s"],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
